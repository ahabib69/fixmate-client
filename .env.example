# BetterAuth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# MongoDB (same DB as the Express server)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# Must match JWT_SECRET in fixmate-server/.env
JWT_SECRET=change-me-to-the-same-long-random-string-as-the-server

# Express API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ImgBB API key for image uploads (https://api.imgbb.com/)
NEXT_PUBLIC_IMGBB_API_KEY=your-imgbb-api-key

# Optional: Google login (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
